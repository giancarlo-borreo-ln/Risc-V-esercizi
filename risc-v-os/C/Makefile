# ---------------------------------------------------------------------------
# Build, test and boot the toy RISC-V OS (C translation).
#
# Targets:
#   make          build os.elf
#   make test     build and run the host unit tests
#   make run      build everything and boot it under qemu
#   make clean    remove generated files
#
# The Makefile folds in everything run.sh used to do:
#   1. generate fakeroot.c, a byte table of host directory names that the toy
#      OS reads as its fake "/" filesystem,
#   2. build os.elf,
#   3. create disk.img on first use,
#   4. locate qemu and an OpenSBI firmware blob,
#   5. run qemu with our kernel.
#
# Tune with FAKE_LIMIT / FAKE_MAXLEN / DISK_IMG / DISK_SIZE / QEMU / CROSS.
# Exit the virtual machine with the `halt` command, Ctrl-C, or Ctrl-A then X.
# ---------------------------------------------------------------------------

# --- parameters (mirror the environment variables of run.sh) ---
FAKE_LIMIT ?= 200          # at most this many directories
FAKE_MAXLEN ?= 100         # skip paths longer than this
DISK_IMG   ?= disk.img
DISK_SIZE  ?= 8M
QEMU       ?=

# Prefer the "unknown-elf" toolchain but fall back to a Linux-targeted one.
CROSS ?= $(shell if command -v riscv64-unknown-elf-gcc >/dev/null 2>&1; then \
                   echo riscv64-unknown-elf-; \
                 else echo riscv64-linux-gnu-; fi)

CC     := $(CROSS)gcc
HOSTCC ?= cc

# -march=rv64gc   RV64G base ISA plus the C compressed extension
# -mabi=lp64d     64-bit longs/pointers, doubles in FP registers
# -mcmodel=medany position-independent-ish code for any 2 GiB window
# -nostdlib       no standard C library (none exists bare-metal)
# -nostartfiles   no C runtime startup (we have our own _start)
# -ffreestanding  we provide our own environment; no main() or libc assumed
# -fno-builtin    stop gcc rewriting loops into memcpy/memset (no libc here)
# -fno-pie        no position-independent executable (fixed load address)
# -Wall -Wextra -Werror  every diagnostic is fatal
CFLAGS := -march=rv64gc -mabi=lp64d -mcmodel=medany \
          -nostdlib -nostartfiles -ffreestanding -fno-builtin \
          -fno-pie -fno-stack-protector -O2 \
          -Wall -Wextra -Werror

# --build-id=none: bare-metal does not want the build-id note.
# --no-warn-rwx-segments: our tiny image legitimately shares one R/W/X segment.
LDFLAGS := -Wl,--build-id=none -Wl,--no-warn-rwx-segments

TARGET := os.elf
OBJS   := main.o uart.o virtio.o fs.o shell.o strutil.o fakeroot.o

all: $(TARGET)

# Force a fresh fakeroot listing every build, exactly like run.sh did.
fakeroot.c: FORCE
	@{ \
	  echo '/* generated by Makefile - do not edit */'; \
	  echo 'const unsigned char fake_paths[] = {'; \
	  find / -mindepth 1 \
	      \( -path /home -o -path /proc -o -path /sys -o -path /dev \
	         -o -path /run -o -path /tmp \) -prune -o \
	      -type d -print 2>/dev/null \
	  | sort -u \
	  | awk -v limit="$(FAKE_LIMIT)" -v maxlen="$(FAKE_MAXLEN)" 'BEGIN { for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i } length($$0) > maxlen { next } { if (++count > limit) exit; printf "\t"; for (i = 1; i <= length($$0); i++) printf "0x%02x,", ord[substr($$0, i, 1)]; printf "0,\n" } END { printf "\t0\n" }'; \
	  echo '};'; \
	} > $@ || echo 'const unsigned char fake_paths[] = { 0 };' > $@

%.o: %.c os.h
	$(CC) $(CFLAGS) -c -o $@ $<

$(TARGET): $(OBJS) linker.ld
	$(CC) $(CFLAGS) $(LDFLAGS) -T linker.ld -o $@ $(OBJS)

disk.img:
	truncate -s $(DISK_SIZE) $@

# ---------------------------------------------------------------------------
# Host unit tests.  The tested modules are compiled natively; uart.c and
# virtio.c are replaced by tests/mock_platform.c.
# ---------------------------------------------------------------------------
TEST_SRCS := tests/test_main.c tests/test_strutil.c tests/test_fs.c \
             tests/test_shell.c tests/mock_platform.c tests/test_fakeroot.c \
             strutil.c fs.c shell.c
TEST_BIN  := tests/test_os
TEST_CFLAGS := -O2 -Wall -Wextra -Werror -I. -Itests

test: $(TEST_SRCS) os.h tests/test.h
	$(HOSTCC) $(TEST_CFLAGS) -o $(TEST_BIN) $(TEST_SRCS)
	$(TEST_BIN)

# ---------------------------------------------------------------------------
# Boot under qemu.
# ---------------------------------------------------------------------------
run: $(TARGET) disk.img
	@set -e; \
	QEMU_BIN="$(QEMU)"; \
	if [ -z "$$QEMU_BIN" ]; then \
	    if command -v qemu-system-riscv64 >/dev/null 2>&1; then \
	        QEMU_BIN="$$(command -v qemu-system-riscv64)"; \
	    elif [ -x .tools/qemu/qemu-system-riscv64 ]; then \
	        QEMU_BIN=".tools/qemu/qemu-system-riscv64"; \
	    elif [ -x ../.tools/qemu/qemu-system-riscv64 ]; then \
	        QEMU_BIN="../.tools/qemu/qemu-system-riscv64"; \
	    else \
	        echo "error: qemu-system-riscv64 not found." >&2; \
	        echo "install it with: sudo apt install qemu-system-riscv" >&2; \
	        exit 1; \
	    fi; \
	fi; \
	BIOS="default"; \
	for f in \
	    /usr/share/qemu/opensbi-riscv64-generic-fw_dynamic.bin \
	    /usr/lib/qemu/opensbi-riscv64-generic-fw_dynamic.bin \
	    .tools/qemu/share/opensbi-riscv64-generic-fw_dynamic.bin \
	    ../.tools/qemu/share/opensbi-riscv64-generic-fw_dynamic.bin; do \
	    if [ -f "$$f" ]; then BIOS="$$f"; break; fi; \
	done; \
	echo "booting os.elf on $$QEMU_BIN (Ctrl-A X to quit)"; \
	exec "$$QEMU_BIN" \
	    -machine virt \
	    -bios "$$BIOS" \
	    -global virtio-mmio.force-legacy=false \
	    -drive if=none,format=raw,id=hd0,file="$(DISK_IMG)" \
	    -device virtio-blk-device,drive=hd0 \
	    -nographic \
	    -serial mon:stdio \
	    -kernel os.elf

clean:
	rm -f $(TARGET) $(OBJS) fakeroot.c $(TEST_BIN)

.PHONY: all test run clean FORCE
